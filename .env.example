# Copy this file to .env for local development (never commit .env itself).
# On Vercel, set these same names under Project → Settings → Environment Variables.

# Postgres connection (Supabase or any Postgres host).
# From Supabase: Project → Connect → use the "Transaction pooler" string
# (port 6543), both here and in Vercel. Do NOT use the "Direct connection"
# string (port 5432) — Supabase's direct-connection hostname resolves to
# IPv6 only, which fails with ENETUNREACH on any network without working
# IPv6 (common on home/office connections). The pooler works on IPv4 and
# also handles serverless functions opening many short-lived connections
# better than a direct connection would.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Set to "false" only for a local/test database without TLS. Leave unset
# (defaults to TLS required) for anything real, including Supabase.
DB_SSL=

# Generate with: node scripts/hash-password.js "your chosen password"
ADMIN_SALT=
ADMIN_HASH=

# Any long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
